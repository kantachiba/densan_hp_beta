---
/**
 * About: 左右非対称2カラム。
 * 左 = リード + 本文 / 右 = 分野チップ（データ駆動）。
 * 下に e-sports 準優勝の一行ハイライト（数字カウンターは置かない方針）。
 */
import Icon from "./Icon.astro";
import { about, fields } from "../data/site";
---

<section id="about" class="section relative">
  <div class="container">
    <!-- フル幅の大型ステートメント -->
    <p class="mb-6 font-mono text-[0.72rem] tracking-[0.34em] uppercase text-volt-cyan" data-reveal>+ About</p>
    <p class="about-lead font-jp text-fog" data-reveal>{about.lead}</p>

    <div class="mt-12 grid gap-14 md:mt-16 md:grid-cols-[1.2fr_1fr] md:gap-16">
      <!-- 左: 本文（リードと同色・同フォント） -->
      <div>
        <p class="about-body font-jp text-fog" data-reveal>
          {about.body}
        </p>
      </div>

      <!-- 右: 分野チップ -->
      <div class="md:pt-2">
        <p class="mb-5 font-mono text-xs tracking-[0.28em] text-fog-mute uppercase" data-reveal>
          Creative Modules
        </p>
        <ul class="flex flex-wrap gap-2.5" data-reveal>
          {
            fields.map((field) => (
              <li class="field-chip inline-flex items-center gap-2 rounded-pill border border-line px-4 py-2 text-[0.85rem] text-fog-dim">
                <Icon name={field.icon} class="h-4 w-4 text-volt-cyan" />
                {field.label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-lead {
    font-size: clamp(2.3rem, 6.2vw, 4.8rem);
    font-weight: 900;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .about-body {
    max-width: 38em;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 2;
  }

  .field-chip {
    transition:
      border-color 0.3s var(--ease-out-expo),
      color 0.3s var(--ease-out-expo);
  }

  .field-chip:hover {
    border-color: color-mix(in oklab, var(--color-volt-cyan) 55%, transparent);
    color: var(--color-fog);
  }

</style>
