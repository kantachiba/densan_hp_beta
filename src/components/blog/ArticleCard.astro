---
import type { ArticleSummary } from "../../lib/server/articles.ts";
import { formatDate } from "../../lib/format.ts";

interface Props {
  article: ArticleSummary;
}

const { article } = Astro.props;
const href = `/news/${article.articleId}`;
---

<article class="card group">
  <a href={href} class="block">
    <div class="thumb">
      {
        article.thumbnailUrl ? (
          <img
            src={article.thumbnailUrl}
            alt=""
            loading="lazy"
            decoding="async"
            style={`object-position: ${article.thumbnailFocusX}% ${article.thumbnailFocusY}%; transform-origin: ${article.thumbnailFocusX}% ${article.thumbnailFocusY}%`}
          />
        ) : (
          <div class="thumb-placeholder" aria-hidden="true">
            <span class="font-jp">{article.title}</span>
          </div>
        )
      }
    </div>
    <div class="pt-5">
      {article.category && <p class="font-mono text-[0.68rem] uppercase tracking-[0.26em] text-volt-cyan">{article.category}</p>}
      <h2 class="title mt-2 font-jp text-fog">{article.title}</h2>
      {article.excerpt && <p class="excerpt mt-3 text-sm text-fog-dim">{article.excerpt}</p>}
      <p class="mt-4 flex flex-wrap items-center gap-x-3 text-xs text-fog-mute">
        <span>{article.authorName}</span>
        <time datetime={article.publishedAt ?? undefined}>{formatDate(article.publishedAt)}</time>
      </p>
    </div>
  </a>
</article>

<style>
  .thumb {
    aspect-ratio: 1.91 / 1;
    overflow: hidden;
    border-radius: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .card:hover .thumb img {
    transform: scale(1.04);
  }

  .thumb-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1.5rem;
    background:
      radial-gradient(120% 90% at 0% 0%, color-mix(in oklab, var(--color-volt) 45%, transparent), transparent 60%),
      radial-gradient(100% 80% at 100% 100%, color-mix(in oklab, var(--color-volt-violet) 35%, transparent), transparent 60%),
      var(--color-ink-3);
  }

  .thumb-placeholder span {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.6;
    text-align: center;
    color: var(--color-fog);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .title {
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.03em;
    transition: color 0.2s;
  }

  .card:hover .title {
    color: var(--color-volt-cyan);
  }

  .excerpt {
    line-height: 1.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
