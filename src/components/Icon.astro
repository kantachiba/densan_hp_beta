---
/**
 * インラインSVGアイコン集。
 * 新しい分野を足すときはここに name を1つ追加して
 * src/data/site.ts の fields から参照する。
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "app" && (
      <>
        <rect x="5" y="2" width="14" height="20" rx="2" />
        <line x1="12" y1="18" x2="12" y2="18" stroke-width="2" />
      </>
    )
  }
  {
    name === "game" && (
      <>
        <rect x="2" y="6" width="20" height="12" rx="2" />
        <line x1="9" y1="10" x2="9" y2="14" />
        <line x1="7" y1="12" x2="11" y2="12" />
        <circle cx="16" cy="10" r="1" fill="currentColor" stroke="none" />
        <circle cx="18" cy="13" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "code" && (
      <>
        <polyline points="16 18 22 12 16 6" />
        <polyline points="8 6 2 12 8 18" />
      </>
    )
  }
  {
    name === "cube" && (
      <>
        <path d="M12 2L2 7l10 5 10-5-10-5z" />
        <path d="M2 17l10 5 10-5" />
        <path d="M2 12l10 5 10-5" />
      </>
    )
  }
  {name === "pen" && <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />}
  {
    name === "chip" && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="2" />
        <rect x="9" y="9" width="6" height="6" />
        <line x1="9" y1="1" x2="9" y2="4" />
        <line x1="15" y1="1" x2="15" y2="4" />
        <line x1="9" y1="20" x2="9" y2="23" />
        <line x1="15" y1="20" x2="15" y2="23" />
        <line x1="20" y1="9" x2="23" y2="9" />
        <line x1="20" y1="14" x2="23" y2="14" />
        <line x1="1" y1="9" x2="4" y2="9" />
        <line x1="1" y1="14" x2="4" y2="14" />
      </>
    )
  }
  {
    name === "film" && (
      <>
        <polygon points="23 7 16 12 23 17 23 7" />
        <rect x="1" y="5" width="15" height="14" rx="2" />
      </>
    )
  }
  {
    name === "pad" && (
      <>
        <rect x="2" y="8" width="20" height="10" rx="5" />
        <line x1="8" y1="11" x2="8" y2="15" />
        <line x1="6" y1="13" x2="10" y2="13" />
        <circle cx="15" cy="12" r="1" fill="currentColor" stroke="none" />
        <circle cx="17" cy="14" r="1" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "link" && (
      <>
        <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" />
        <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" />
      </>
    )
  }
  {name === "play" && <polygon points="6 4 20 12 6 20 6 4" fill="currentColor" />}
  {
    name === "external" && (
      <>
        <path d="M14 4h6v6" />
        <path d="M20 4l-9 9" />
        <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
      </>
    )
  }
  {
    name === "arrow" && (
      <>
        <path d="M5 12h14M12 5l7 7-7 7" stroke-width="2" />
      </>
    )
  }
</svg>
