---
import Base from "./Base.astro";
import "../styles/admin.css";
import { ROLE_LABEL } from "../lib/server/users.ts";

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user!;
const path = Astro.url.pathname;

const links = [
  { href: "/admin/articles", label: "記事", show: true },
  { href: "/admin/members", label: "メンバー", show: true },
  { href: "/admin/users", label: "ユーザー管理", show: user.role === "admin" },
  { href: "/admin/account", label: "アカウント", show: true },
].filter((l) => l.show);
---

<Base title={`${title} | 電算機部 CMS`} noindex decor={false}>
  <header class="sticky top-0 z-40 border-b border-line bg-ink/90 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-[1100px] items-center gap-6 px-6">
      <a href="/admin/articles" class="flex shrink-0 items-center gap-2.5">
        <img src="/img/logo.svg" alt="" class="h-8 w-auto" />
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.28em] text-fog-dim max-sm:hidden">CMS</span>
      </a>
      <nav class="flex items-center gap-1 overflow-x-auto">
        {
          links.map((l) => (
            <a href={l.href} class:list={["adm-tab", path.startsWith(l.href) && "adm-tab--on"]}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto flex shrink-0 items-center gap-3">
        <a href="/news" target="_blank" class="text-xs text-fog-mute hover:text-fog max-md:hidden">サイトを見る ↗</a>
        <span class="text-right text-xs leading-tight max-sm:hidden">
          <span class="block text-fog">{user.displayName}</span>
          <span class="text-fog-mute">{ROLE_LABEL[user.role]}</span>
        </span>
        <form method="post" action="/logout">
          <button class="adm-btn adm-btn--sm">ログアウト</button>
        </form>
      </div>
    </div>
  </header>
  <main class="mx-auto max-w-[1100px] px-6 pb-24 pt-10">
    <slot />
  </main>
</Base>
