---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** OGP 画像（サイト内パス or 絶対URL） */
  image?: string | null;
  /** og:type（記事ページは "article"） */
  type?: "website" | "article";
  publishedTime?: string | null;
  modifiedTime?: string | null;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  /** トップページのブート演出を有効にする */
  home?: boolean;
  /** 背景の縦罫線・フィルムグレイン（管理画面では切る） */
  decor?: boolean;
}

const SITE_NAME = "長岡高専 電算機部";
const {
  title = "長岡高専 電算機部 | NITNC Computer Club",
  description = "Don't stop creation ー 長岡高専電算機部公式サイト。創部から40年以上、プログラミング・ゲーム制作・映像・3D・eスポーツなど多岐にわたるクリエイティブ活動を行っています。",
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  noindex = false,
  home = false,
  decor = true,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname + Astro.url.search, site).href;
const ogImage = new URL(image || "/img/colordensan.png", site).href;
const largeCard = !!image;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === "article" && author && <meta property="article:author" content={author} />}
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={largeCard ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content="@NNCT_Densan" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/img/colordensan.png" type="image/png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Noto+Sans+JP:wght@400;500;700;900&family=Orbit&family=Space+Grotesk:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />

    <!-- ブート演出を再生するかを描画前に判定（フラッシュ防止）:
         reduced-motion / セッション内再訪 / JS無効 → 再生しない -->
    {
      home && (
        <script is:inline>
          try {
            if (
              !matchMedia("(prefers-reduced-motion: reduce)").matches &&
              !sessionStorage.getItem("densan-booted")
            ) {
              document.documentElement.classList.add("boot-pending");
            }
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    {decor && <div class="page-grid" aria-hidden="true" />}
    <slot />
    {decor && <div class="grain" aria-hidden="true" />}
  </body>
</html>
